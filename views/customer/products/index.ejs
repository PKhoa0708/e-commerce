<%- await include('../../partials/header') %>

<h2>Danh sách sản phẩm</h2>

<form method="GET" action="/customer/products" style="margin:15px 0;">
    <input
        type="text"
        name="keyword"
        placeholder="Nhập tên sản phẩm..."
        value="<%= keyword %>"
        style="width:300px; padding:8px;"
    >
    <button type="submit" style="padding:8px 12px;">Tìm kiếm</button>
    <a href="/customer/products" style="padding:8px 12px; background:gray; color:white; text-decoration:none;">Làm mới</a>
</form>

<% if (products.length > 0) { %>
    <div style="display:flex; flex-wrap:wrap; gap:20px;">
        <% for (let product of products) {
            const product_id = Number(product.id);

            const img_doc = await db.collection('product_images').findOne(
                { product_id: product_id },
                { sort: { is_main: -1, id: 1 } }
            );

            let image = null;
            if (img_doc) {
                image = img_doc.image_path;
            } else if (product.thumbnail) {
                image = product.thumbnail;
            }
        %>

            <div style="width:240px; border:1px solid #ccc; padding:15px; border-radius:6px; background:#fff;">
                <div style="text-align:center; margin-bottom:10px;">
                    <% if (image) { %>
                        <img
                            src="/<%= image.replace(/^\/+/, '') %>"
                            style="width:180px; height:180px; object-fit:cover;"
                        >
                    <% } else { %>
                        <div style="width:180px; height:180px; background:#eee; display:flex; align-items:center; justify-content:center; margin:0 auto;">
                            Không có ảnh
                        </div>
                    <% } %>
                </div>

                <h3 style="font-size:18px; margin-bottom:8px;">
                    <%= product.name %>
                </h3>

                <p><strong>Danh mục:</strong> <%= product.category_name || '' %></p>
                <p><strong>Giá:</strong> <%= Number(product.price).toLocaleString('vi-VN') %> đ</p>
                <p><strong>Tồn kho:</strong> <%= Number(product.stock_quantity) %></p>

                <div style="margin-top:12px;">
                    <a
                        href="/customer/products/detail?id=<%= product.id %>"
                        style="padding:8px 12px; background:blue; color:white; text-decoration:none;"
                    >
                        Xem chi tiết
                    </a>
                </div>
            </div>
        <% } %>
    </div>
<% } else { %>
    <p>Không tìm thấy sản phẩm nào.</p>
<% } %>

<%- await include('../../partials/footer') %>
