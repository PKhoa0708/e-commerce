<%- await include('../../../partials/header') %>

<style>
    body { font-family: Arial, sans-serif; }
    h2 { margin-bottom: 20px; }
    .top-actions { margin-bottom: 15px; }
    .filter-form {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }
    .filter-form input, .filter-form select, .filter-form button {
        padding: 8px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
    }
    table th, table td {
        border: 1px solid #ddd;
        padding: 10px;
        text-align: left;
        vertical-align: top;
    }
    table th {
        background: #f5f5f5;
    }
    .btn {
        display: inline-block;
        padding: 6px 10px;
        text-decoration: none;
        border-radius: 4px;
        border: 1px solid #ccc;
        background: #f8f8f8;
        color: #000;
        margin-right: 5px;
    }
    .msg {
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 4px;
    }
    .msg-success { background: #d4edda; color: #155724; }
    .msg-error { background: #f8d7da; color: #721c24; }
</style>

<h2>Quản lý đơn hàng</h2>

<div class="top-actions">
    <a class="btn" href="/staff/dashboard">← Quay lại dashboard</a>
</div>

<% if (success) { %>
    <div class="msg msg-success"><%= success %></div>
<% } %>

<% if (error) { %>
    <div class="msg msg-error"><%= error %></div>
<% } %>

<%
const order_statuses = ['Chờ xác nhận', 'Đã xác nhận', 'Đang chuẩn bị', 'Đang giao', 'Đã giao', 'Đã hoàn thành', 'Đã hủy'];
const payment_statuses = ['Chưa thanh toán', 'Đã thanh toán', 'Thất bại', 'Hoàn tiền'];

function getPaymentText(ps) {
    ps = (ps || '').toString().trim();
    if (!ps || ps === 'Đang chờ') return 'Chưa thanh toán';
    return ps;
}

function formatMoney(amount) {
    return Number(amount || 0).toLocaleString('vi-VN') + ' đ';
}
%>

<form method="GET" class="filter-form">
    <input type="text" name="keyword" placeholder="Tìm theo mã đơn, người nhận, SĐT"
           value="<%= keyword %>">

    <select name="order_status">
        <option value="">-- Trạng thái đơn hàng --</option>
        <% order_statuses.forEach(s => { %>
            <option value="<%= s %>" <%= (order_status === s) ? 'selected' : '' %>><%= s %></option>
        <% }) %>
    </select>

    <select name="payment_status">
        <option value="">-- Trạng thái thanh toán --</option>
        <% payment_statuses.forEach(ps => { %>
            <option value="<%= ps %>" <%= (payment_status === ps) ? 'selected' : '' %>><%= ps %></option>
        <% }) %>
    </select>

    <button type="submit">Lọc</button>
    <a class="btn" href="/staff/orders">Reset</a>
</form>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Người nhận</th>
            <th>SĐT</th>
            <th>Thanh toán</th>
            <th>Trạng thái đơn</th>
            <th>Tổng tiền</th>
            <th>Ngày tạo</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        <% if (orders.length > 0) { %>
            <% orders.forEach(row => { %>
                <tr>
                    <td><%= row.id %></td>
                    <td><%= row.order_code %></td>
                    <td><%= row.customer_name || '' %></td>
                    <td><%= row.receiver_name %></td>
                    <td><%= row.receiver_phone %></td>
                    <td><%= getPaymentText(row.payment_status) %></td>
                    <td><%= row.order_status %></td>
                    <td><%= formatMoney(row.total_amount) %></td>
                    <td><%= formatDate(row.created_at) %></td>
                    <td>
                        <a class="btn" href="/staff/orders/detail?id=<%= row.id %>">Chi tiết</a>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr>
                <td colspan="10">Không có đơn hàng nào.</td>
            </tr>
        <% } %>
    </tbody>
</table>

<%- await include('../../../partials/footer') %>
