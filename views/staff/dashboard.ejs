<%- await include('../../partials/header') %>

<style>
    .staff-dashboard-page {
        background: linear-gradient(180deg, #F6F8FC 0%, #FFF8F8 100%);
        min-height: calc(100vh - 120px);
        padding: 32px 0 70px;
    }

    .staff-dashboard-page * {
        box-sizing: border-box;
    }

    .staff-dashboard-page .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 16px;
    }

    .staff-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 34px;
        margin-bottom: 24px;
        background:
            linear-gradient(135deg, rgba(229, 57, 53, 0.94), rgba(255, 179, 0, 0.84)),
            url('https://images.unsplash.com/photo-1556740749-887f6717d7e4?auto=format&fit=crop&w=1400&q=80') center/cover no-repeat;
        color: #fff;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.14);
    }

    .staff-hero::before {
        content: "";
        position: absolute;
        top: -70px;
        right: -70px;
        width: 210px;
        height: 210px;
        border-radius: 50%;
        background: rgba(255,255,255,0.10);
    }

    .staff-hero::after {
        content: "";
        position: absolute;
        left: -90px;
        bottom: -90px;
        width: 250px;
        height: 250px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
    }

    .staff-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        flex-wrap: wrap;
    }

    .staff-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.18);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 14px;
    }

    .staff-hero h1 {
        margin: 0 0 10px;
        font-size: clamp(30px, 4vw, 46px);
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.6px;
    }

    .staff-hero p {
        margin: 0;
        max-width: 760px;
        color: rgba(255,255,255,0.94);
        font-size: 16px;
        line-height: 1.7;
    }

    .staff-name-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 18px;
        border-radius: 14px;
        background: #fff;
        color: #E53935;
        font-weight: 800;
        box-shadow: 0 10px 24px rgba(0,0,0,0.10);
        white-space: nowrap;
    }

    .staff-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .staff-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
        padding: 26px 24px;
        transition: 0.28s ease;
    }

    .staff-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 24px 50px rgba(15, 23, 42, 0.10);
    }

    .staff-card-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 18px;
        background: linear-gradient(135deg, rgba(229,57,53,.14), rgba(255,179,0,.18));
    }

    .staff-card-title {
        margin: 0 0 10px;
        font-size: 24px;
        font-weight: 800;
        color: #111827;
    }

    .staff-card-desc {
        margin: 0 0 20px;
        color: #6B7280;
        font-size: 15px;
        line-height: 1.7;
    }

    .staff-card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .staff-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        padding: 0 18px;
        border-radius: 16px;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none;
        transition: 0.25s ease;
    }

    .staff-btn.primary {
        background: linear-gradient(135deg, #E53935, #FF6B57);
        color: #fff;
        box-shadow: 0 14px 28px rgba(229, 57, 53, 0.22);
    }

    .staff-btn.primary:hover {
        transform: translateY(-1px);
    }

    .staff-btn.secondary {
        background: #F3F4F6;
        color: #374151;
        border: 1px solid #E5E7EB;
    }

    .staff-btn.secondary:hover {
        background: #E5E7EB;
    }

    .staff-summary {
        margin-top: 24px;
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
        padding: 26px 24px;
    }

    .staff-summary-title {
        margin: 0 0 10px;
        font-size: 24px;
        font-weight: 800;
        color: #111827;
    }

    .staff-summary-text {
        margin: 0;
        color: #6B7280;
        font-size: 15px;
        line-height: 1.8;
        max-width: 900px;
    }

    @media (max-width: 900px) {
        .staff-grid {
            grid-template-columns: 1fr;
        }

        .staff-hero {
            padding: 26px 20px;
            border-radius: 24px;
        }
    }
</style>

<div class="staff-dashboard-page">
    <div class="container">
        <section class="staff-hero">
            <div class="staff-hero-content">
                <div>
                    <div class="staff-badge">🧑‍💼 Khu vực nhân viên bán hàng</div>
                    <h1>Trang nhân viên bán hàng</h1>
                    <p>
                        Xin chào <%= session.full_name %>. Tại đây bạn có thể quản lý sản phẩm,
                        theo dõi đơn hàng và hỗ trợ vận hành bán hàng một cách nhanh chóng, trực quan hơn.
                    </p>
                </div>

                <div class="staff-name-chip">
                    <%= session.full_name %>
                </div>
            </div>
        </section>

        <div class="staff-grid">
            <div class="staff-card">
                <div class="staff-card-icon">📦</div>
                <h2 class="staff-card-title">Quản lý sản phẩm</h2>
                <p class="staff-card-desc">
                    Xem danh sách sản phẩm, cập nhật thông tin và hỗ trợ xử lý hàng hóa trong hệ thống bán hàng.
                </p>
                <div class="staff-card-actions">
                    <a href="/staff/products" class="staff-btn primary">Mở quản lý sản phẩm</a>
                </div>
            </div>

            <div class="staff-card">
                <div class="staff-card-icon">🧾</div>
                <h2 class="staff-card-title">Quản lý đơn hàng</h2>
                <p class="staff-card-desc">
                    Theo dõi các đơn hàng, cập nhật trạng thái xử lý và hỗ trợ quá trình bán hàng cho khách.
                </p>
                <div class="staff-card-actions">
                    <a href="/staff/orders" class="staff-btn primary">Mở quản lý đơn hàng</a>
                </div>
            </div>
        </div>

        <div class="staff-summary">
            <h3 class="staff-summary-title">Tổng quan công việc</h3>
            <p class="staff-summary-text">
                Giao diện này được tối ưu để nhân viên thao tác nhanh, dễ quan sát và thuận tiện điều hướng giữa các phân hệ.
                Bạn có thể dùng đây như trang trung tâm trước khi đi vào quản lý sản phẩm hoặc quản lý đơn hàng.
            </p>
        </div>
    </div>
</div>

<%- await include('../../partials/footer') %>
